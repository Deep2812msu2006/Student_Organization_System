# Local development only. Create the database/user yourself; do not use a superuser for the app.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgresql://club_user:CHANGE_ME@127.0.0.1:5432/student_organization
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=4000
# Optional CA file for a remote database that requires TLS. Never disable certificate checks.
# DB_SSL_CA_FILE=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for auth; use a unique secret per environment. Never commit the real value.
SESSION_SECRET=
# Provisional association year end, evaluated in UTC, exclusive of the next day.
MEMBERSHIP_YEAR_END_MONTH=3
MEMBERSHIP_YEAR_END_DAY=31
# Set 1 only behind one trusted reverse proxy with HTTPS in production.
TRUST_PROXY=0

# Stable independent secret for recoverable admission codes; do not rotate without reissuing tickets.
TICKET_SECRET=
